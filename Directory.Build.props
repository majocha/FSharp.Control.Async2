<Project>
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.fsproj'">
    <!-- Use the compiler and FSharp.Core produced by the local F# checkout. -->
    <RuntimeAsyncBin Condition="'$(RuntimeAsyncBin)' == '' and '$(RuntimeAsyncBitsPath)' != ''">$(RuntimeAsyncBitsPath)</RuntimeAsyncBin>
    <RuntimeAsyncBin Condition="'$(RuntimeAsyncBin)' == ''">E:\repos\fsharp\artifacts\bin</RuntimeAsyncBin>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <DotnetFscCompilerPath>$(RuntimeAsyncBin)\fsc\Release\net11.0\fsc.dll</DotnetFscCompilerPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.fsproj'">
    <Reference Include="FSharp.Core">
      <HintPath>$(RuntimeAsyncBin)\FSharp.Core\Release\net10.0\FSharp.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
