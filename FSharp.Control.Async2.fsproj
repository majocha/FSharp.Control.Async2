<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RuntimeAsyncBin>D:\source\fsharp\artifacts\bin</RuntimeAsyncBin>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <DotnetFscCompilerPath>$(RuntimeAsyncBin)\fsc\Release\net11.0\fsc.dll</DotnetFscCompilerPath>
    <AssemblyName>FSharp.Control.Async2</AssemblyName>
    <RootNamespace>Microsoft.FSharp.Control</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\FSharp.Control.Async2\Async2.fsi" />
    <Compile Include="src\FSharp.Control.Async2\Async2.fs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="FSharp.Core">
      <HintPath>$(RuntimeAsyncBin)\FSharp.Core\Release\net10.0\FSharp.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
