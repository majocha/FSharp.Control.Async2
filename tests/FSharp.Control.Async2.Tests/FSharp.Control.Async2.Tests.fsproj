<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <LangVersion>preview</LangVersion>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <AssemblyName>FSharp.Control.Async2.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="TestSupport.fs" />
    <Compile Include="AsyncType.fs" />
    <Compile Include="AsyncModule.fs" />
    <Compile Include="AsyncModuleFunctions.fs" />
    <Compile Include="AsyncCompilerRegressionTests.fs" />
    <ProjectReference Include="..\..\FSharp.Control.Async2.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <PackageReference Include="xunit.v3.runner.console" Version="3.2.2" />
    <PackageReference Include="xunit.v3.common" Version="3.2.2" />
    <PackageReference Include="xunit.v3.assert" Version="3.2.2" />
    <PackageReference Include="xunit.v3.extensibility.core" Version="3.2.2" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="xunit.v3.core" HintPath="$(Pkgxunit_v3_extensibility_core)\lib\netstandard2.0\xunit.v3.core.dll" />
  </ItemGroup>
</Project>
